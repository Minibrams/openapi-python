def _serialize_value(value: object) -> object:
    if isinstance(value, Enum):
        return value.value
    return value


def _serialize_scalar(value: object) -> str:
    return str(_serialize_value(value))


def _serialize_path_params(values: Mapping[str, object] | None) -> dict[str, str]:
    return {
        key: quote(_serialize_scalar(value), safe="")
        for key, value in (values or {}).items()
    }


def _serialize_query(values: Mapping[str, object] | None) -> list[tuple[str, str]] | None:
    query: list[tuple[str, str]] = []
    for key, value in (values or {}).items():
        if value is None:
            continue
        if isinstance(value, (list, tuple, set, frozenset)):
            query.extend((key, _serialize_scalar(item)) for item in value)
        else:
            query.append((key, _serialize_scalar(value)))
    return query or None


def _serialize_headers(values: Mapping[str, object] | None) -> dict[str, str] | None:
    headers = {
        key: _serialize_scalar(value)
        for key, value in (values or {}).items()
        if value is not None
    }
    return headers or None


def _is_json_media_type(media_type: str) -> bool:
    return media_type == "application/json" or media_type.endswith("+json")


def _is_bytes(value: object) -> bool:
    return isinstance(value, (bytes, bytearray))


def _form_data(body: Mapping[str, object]) -> dict[str, str] | None:
    data = {
        key: _serialize_scalar(value)
        for key, value in body.items()
        if value is not None and not _is_bytes(value)
    }
    return data or None


def _form_files(body: Mapping[str, object]) -> dict[str, tuple[str, bytes]] | None:
    files = {
        key: (key, bytes(value))
        for key, value in body.items()
        if _is_bytes(value)
    }
    return files or None


def _body_kwargs(body: object | None, media_type: str | None) -> dict[str, object]:
    if body is None:
        return {}
    if media_type == "multipart/form-data":
        if not isinstance(body, Mapping):
            return {"content": body}
        return {
            "data": _form_data(body),
            "files": _form_files(body),
        }
    if media_type == "application/x-www-form-urlencoded":
        if isinstance(body, Mapping):
            return {"data": _form_data(body)}
        return {"content": body}
    if media_type is None or _is_json_media_type(media_type):
        return {"json": body}
    return {"content": body}


def _request_kwargs(
    *,
    method: str,
    route: str,
    base_url: str,
    params: Mapping[str, object] | None,
    query: Mapping[str, object] | None,
    headers: Mapping[str, object] | None,
    request_media_type: str | None,
    body: object | None,
) -> dict[str, object]:
    formatted_route = route.format(**_serialize_path_params(params))
    return {
        "method": method.upper(),
        "url": f"{base_url.rstrip('/')}{formatted_route}",
        "params": _serialize_query(query),
        "headers": _serialize_headers(headers),
        **_body_kwargs(body, request_media_type),
    }


def _response_header(response: Any, name: str) -> str:
    headers = getattr(response, "headers", {})
    if not headers:
        return ""
    return str(headers.get(name) or headers.get(name.title()) or "")


def _response_media_type(response: Any, expected: str | None) -> str:
    actual = _response_header(response, "content-type").split(";", 1)[0].strip()
    return (actual or expected or "").lower()


def _read_response(response: Any, expected_media_type: str | None) -> object:
    response.raise_for_status()
    if not response.content:
        return None

    media_type = _response_media_type(response, expected_media_type)
    if _is_json_media_type(media_type):
        return response.json()
    if media_type.startswith("text/"):
        return response.text
    return response.content


class DefaultTransport:
    def __init__(self, *, client: httpx.Client | None = None) -> None:
        if client is None:
            import httpx

            client = httpx.Client()
        self._client = client

    def request(
        self,
        *,
        method: str,
        route: str,
        base_url: str,
        params: Mapping[str, object] | None,
        query: Mapping[str, object] | None,
        headers: Mapping[str, object] | None,
        request_media_type: str | None,
        body: object | None,
        response_media_type: str | None,
    ) -> object:
        response = self._client.request(
            **_request_kwargs(
                method=method,
                route=route,
                base_url=base_url,
                params=params,
                query=query,
                headers=headers,
                request_media_type=request_media_type,
                body=body,
            )
        )
        return _read_response(response, response_media_type)


class DefaultAsyncTransport:
    def __init__(self, *, client: httpx.AsyncClient | None = None) -> None:
        if client is None:
            import httpx

            client = httpx.AsyncClient()
        self._client = client

    async def request(
        self,
        *,
        method: str,
        route: str,
        base_url: str,
        params: Mapping[str, object] | None,
        query: Mapping[str, object] | None,
        headers: Mapping[str, object] | None,
        request_media_type: str | None,
        body: object | None,
        response_media_type: str | None,
    ) -> object:
        response = await self._client.request(
            **_request_kwargs(
                method=method,
                route=route,
                base_url=base_url,
                params=params,
                query=query,
                headers=headers,
                request_media_type=request_media_type,
                body=body,
            )
        )
        return _read_response(response, response_media_type)
